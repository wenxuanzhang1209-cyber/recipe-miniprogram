/* styles/base.wxss — 全局通用组件样式
 * 布局工具类、按钮、徽章、卡片、骨架屏、空状态、动效
 */

/* ===== 布局工具类 ===== */
.flex { display: flex; }
.flex-col { display: flex; flex-direction: column; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; }

/* ===== 文本工具 ===== */
.text-primary { color: var(--primary); }
.text-sub { color: var(--text-sub); }
.text-light { color: var(--text-light); }

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* ===== 卡片 ===== */
.card {
  background: var(--card-bg);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow);
}

/* ===== 标签徽章 ===== */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
  background: var(--primary-bg);
  color: var(--primary);
}
.badge-gray {
  background: var(--gray-100);
  color: var(--text-sub);
}

/* ===== 按钮 ===== */
button {
  margin: 0;
  padding: 0;
  background: none;
  border-radius: 0;
  line-height: inherit;
  font-size: inherit;
}
button::after { border: none; }

.btn-primary {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: var(--text-inverse);
  border-radius: var(--radius-full);
  padding: 24rpx 0;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: var(--shadow-primary);
  transition: opacity var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
}
.btn-primary:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.btn-ghost {
  background: var(--gray-100);
  color: var(--text-sub);
  border-radius: var(--radius-full);
  padding: 20rpx 0;
  font-size: var(--font-size-base);
  text-align: center;
  transition: opacity var(--duration-fast) var(--ease-out);
}
.btn-ghost:active { opacity: 0.7; }

/* ===== 骨架屏 ===== */
@keyframes skeleton-pulse {
  0% { opacity: 1; }
  50% { opacity: 0.45; }
  100% { opacity: 1; }
}
.skeleton {
  background: #ECEFF1;
  border-radius: var(--radius-sm);
  animation: skeleton-pulse 1.4s ease-in-out infinite;
}

/* ===== 动效 ===== */
@keyframes fade-in-up {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.fade-in {
  animation: fade-in-up var(--duration-slow) var(--ease-out) both;
}

@keyframes scale-in {
  from { opacity: 0; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1); }
}
.scale-in {
  animation: scale-in var(--duration-base) var(--ease-spring) both;
}

/* ===== 空状态 ===== */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: var(--text-light);
}
.empty-icon { font-size: 96rpx; margin-bottom: 24rpx; }
.empty-text { font-size: var(--font-size-base); }
.empty-action {
  margin-top: 32rpx;
  padding: 16rpx 48rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-sm);
  color: var(--primary);
  background: var(--primary-bg);
}

/* ===== 加载更多 ===== */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
  font-size: var(--font-size-sm);
  color: var(--text-light);
}
.load-more-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--text-light);
  margin: 0 6rpx;
  animation: skeleton-pulse 1.2s ease-in-out infinite;
}
.load-more-dot:nth-child(2) { animation-delay: 0.2s; }
.load-more-dot:nth-child(3) { animation-delay: 0.4s; }

/* ===== 分割线 ===== */
.divider {
  height: 1rpx;
  background: var(--divider);
  margin: var(--space-lg) 0;
}
