/* styles/tokens.wxss — 设计 Token 定义
 * 全局唯一的设计变量来源，所有页面/组件通过 CSS 变量引用
 * 暖橙主题 · 自然 · 干净 · 有食欲
 */
page {
  /* ===== 色彩 ===== */
  --primary: #FF6B35;
  --primary-light: #FF8C61;
  --primary-dark: #E5551F;
  --primary-bg: #FFF1EB;
  --primary-bg-deep: #FFE4D6;

  --text-main: #2D3436;
  --text-sub: #636E72;
  --text-light: #9CA3AF;
  --text-inverse: #FFFFFF;

  --bg: #F8F9FA;
  --card-bg: #FFFFFF;
  --divider: #F0F0F0;
  --border: #E8EAED;

  --success: #00B894;
  --success-bg: #E8F8F5;
  --warning: #FDCB6E;
  --warning-bg: #FEF9E7;
  --danger: #E74C3C;
  --danger-bg: #FFF3F3;

  --gray-100: #F3F4F6;
  --gray-200: #E5E7EB;
  --gray-300: #D1D5DB;

  /* ===== 字体 ===== */
  --font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  --font-size-xs: 20rpx;
  --font-size-sm: 24rpx;
  --font-size-base: 28rpx;
  --font-size-md: 30rpx;
  --font-size-lg: 34rpx;
  --font-size-xl: 40rpx;
  --font-size-2xl: 48rpx;

  --font-weight-normal: 400;
  --font-weight-medium: 500;
  --font-weight-bold: 700;

  --line-height-tight: 1.3;
  --line-height-base: 1.6;

  /* ===== 间距 ===== */
  --space-xs: 8rpx;
  --space-sm: 12rpx;
  --space-md: 16rpx;
  --space-lg: 24rpx;
  --space-xl: 32rpx;
  --space-2xl: 48rpx;

  /* ===== 圆角 ===== */
  --radius-xs: 8rpx;
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 32rpx;
  --radius-full: 100rpx;

  /* ===== 阴影 ===== */
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  --shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 8rpx 40rpx rgba(0, 0, 0, 0.10);
  --shadow-primary: 0 8rpx 24rpx rgba(255, 107, 53, 0.30);
  --shadow-top: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);

  /* ===== 动效 ===== */
  --duration-fast: 0.15s;
  --duration-base: 0.25s;
  --duration-slow: 0.35s;
  --ease-out: cubic-bezier(0.25, 0.46, 0.45, 0.94);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);

  /* ===== 层级 ===== */
  --z-dropdown: 100;
  --z-sticky: 200;
  --z-modal: 500;
  --z-toast: 900;

  /* ===== 基础 ===== */
  background: var(--bg);
  color: var(--text-main);
  font-family: var(--font-family);
  font-size: var(--font-size-base);
  line-height: var(--line-height-base);
}
