/* pages/detail/detail.wxss */
.page { padding-bottom: 40rpx; }

/* 大图 */
.hero { width: 100%; height: 480rpx; }
.hero-img { width: 100%; height: 100%; }

/* 标题卡 */
.head-card {
  margin: -60rpx 24rpx 0;
  position: relative;
  z-index: 2;
  padding: 32rpx;
}
.head-title { font-size: 40rpx; font-weight: 700; }
.head-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}
.head-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.7;
}

.stat-row {
  display: flex;
  margin-top: 28rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid var(--divider);
}
.stat-item { flex: 1; text-align: center; }
.stat-value { font-size: 28rpx; font-weight: 700; color: var(--text-main); }
.stat-label { font-size: 22rpx; color: var(--text-light); margin-top: 4rpx; }
.star-mini { font-size: 22rpx; color: #E5E7EB; }
.star-mini.on { color: #FDCB6E; }

/* 通用区块卡 */
.section-card {
  margin: 24rpx 24rpx 0;
  padding: 32rpx;
}
.sec-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}
.sec-hint {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-light);
  margin-left: 12rpx;
}

/* 做菜模式入口 */
.cookmode-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding: 24rpx;
  border-radius: var(--radius-sm);
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  transition: opacity var(--duration-fast);
}
.cookmode-entry:active { opacity: 0.85; }
.cookmode-left { display: flex; align-items: center; gap: 20rpx; }
.cookmode-icon { font-size: 44rpx; }
.cookmode-title { font-size: 30rpx; font-weight: 700; color: #fff; }
.cookmode-sub { font-size: 22rpx; color: rgba(255, 255, 255, 0.85); margin-top: 2rpx; }
.cookmode-arrow { font-size: 40rpx; color: rgba(255, 255, 255, 0.9); }

/* 过敏原提醒 */
.allergen-card {
  margin: 24rpx 24rpx 0;
  padding: 24rpx 28rpx;
  border-radius: var(--radius-md);
  background: var(--danger-bg);
  border: 1rpx solid rgba(231, 76, 60, 0.25);
}
.allergen-title { font-size: 28rpx; font-weight: 700; color: var(--danger); }
.allergen-item {
  display: inline-block;
  margin: 12rpx 12rpx 0 0;
  padding: 6rpx 18rpx;
  border-radius: var(--radius-full);
  font-size: 24rpx;
  color: var(--danger);
  background: rgba(231, 76, 60, 0.12);
}
.allergen-tip { margin-top: 12rpx; font-size: 22rpx; color: var(--text-sub); }

/* 食材标题行 + 人数步进器 */
.sec-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.sec-title-row .sec-title { margin-bottom: 0; }
.servings-stepper { display: flex; align-items: center; gap: 16rpx; }
.st-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--primary);
  background: var(--primary-bg);
  transition: opacity var(--duration-fast);
}
.st-btn:active { opacity: 0.7; }
.st-btn.disabled { opacity: 0.35; }
.st-val { font-size: 26rpx; font-weight: 600; color: var(--text-main); min-width: 72rpx; text-align: center; }

/* 食材 */
.ing-group { margin-bottom: 20rpx; }
.ing-group-name {
  font-size: 24rpx;
  color: var(--text-light);
  margin-bottom: 12rpx;
}
.ing-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--divider);
  transition: opacity 0.2s;
}
.ing-row.checked { opacity: 0.45; }
.ing-row.checked .ing-name { text-decoration: line-through; }
.ing-check {
  width: 36rpx; height: 36rpx;
  border: 2rpx solid #D1D5DB;
  border-radius: 10rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--primary);
}
.ing-row.checked .ing-check {
  background: var(--primary-bg);
  border-color: var(--primary);
}
.ing-name { flex: 1; font-size: 28rpx; }
.ing-amount { font-size: 26rpx; color: var(--text-sub); }

/* 步骤 */
.step { display: flex; }
.step-num-line {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 24rpx;
}
.step-num {
  width: 52rpx; height: 52rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #fff;
  border-radius: 50%;
  font-size: 26rpx;
  font-weight: 700;
}
.step-line {
  flex: 1;
  width: 3rpx;
  background: #FFE0D3;
  margin: 8rpx 0;
}
.step-body { flex: 1; padding-bottom: 36rpx; min-width: 0; }
.step-desc { font-size: 28rpx; line-height: 1.7; }
.step-img {
  width: 100%;
  height: 300rpx;
  margin-top: 16rpx;
  border-radius: 16rpx;
}

/* 小贴士 */
.tips-card { background: #FFFBEB; }
.tips-text {
  font-size: 26rpx;
  color: #926B1D;
  line-height: 1.8;
  white-space: pre-line;
}

/* 营养 */
.nutri-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}
.nutri-item {
  text-align: center;
  padding: 20rpx 0;
  background: var(--bg);
  border-radius: 16rpx;
}
.nutri-val { font-size: 30rpx; font-weight: 700; color: var(--primary); }
.nutri-label { font-size: 22rpx; color: var(--text-light); margin-top: 4rpx; }

/* 相关推荐 */
.related-title { margin: 0 0 20rpx; }
.related-scroll { white-space: nowrap; }
.related-list { display: inline-flex; gap: 20rpx; padding-bottom: 8rpx; }
.related-item { width: 300rpx; display: inline-block; }

/* 底部操作栏 */
.footer-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 16rpx 32rpx calc(env(safe-area-inset-bottom) + 16rpx);
  background: #fff;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
  z-index: 50;
}
.fav-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 90rpx;
  transition: transform 0.15s;
}
.fav-btn:active { transform: scale(1.15); }
.fav-icon { font-size: 44rpx; line-height: 1.2; }
.fav-count { font-size: 20rpx; color: var(--text-light); }
.share-btn { flex: 1; }
.footer-space { height: 160rpx; }

/* 骨架 */
.hero-sk { height: 480rpx; border-radius: 0; }
.block-sk { height: 260rpx; margin: 24rpx; }
