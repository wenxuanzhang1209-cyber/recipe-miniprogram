/* pages/cook/cook.wxss - 做菜模式（深色沉浸） */
.cook-page {
  min-height: 100vh;
  background: #1E2226;
  color: #fff;
  display: flex;
  flex-direction: column;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.cook-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 240rpx;
}

/* 顶部 */
.cook-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
}
.cook-exit { font-size: 28rpx; color: rgba(255, 255, 255, 0.7); padding: 8rpx; }
.cook-progress-text { font-size: 28rpx; font-weight: 600; color: #fff; }
.cook-ing-btn {
  font-size: 26rpx;
  color: var(--primary-light);
  background: rgba(255, 107, 53, 0.15);
  padding: 10rpx 24rpx;
  border-radius: 100rpx;
}

.cook-progress-bar {
  height: 6rpx;
  background: rgba(255, 255, 255, 0.12);
  margin: 0 32rpx;
  border-radius: 100rpx;
  overflow: hidden;
}
.cook-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary), var(--primary-light));
  border-radius: 100rpx;
  transition: width 0.3s ease;
}

/* 步骤区 */
.cook-step-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 60rpx 48rpx;
}
.cook-step-num {
  font-size: 26rpx;
  letter-spacing: 4rpx;
  color: var(--primary-light);
  font-weight: 700;
  margin-bottom: 24rpx;
}
.cook-step-desc {
  font-size: 44rpx;
  line-height: 1.6;
  font-weight: 500;
  color: #fff;
}
.cook-step-img {
  margin-top: 40rpx;
  width: 100%;
  height: 360rpx;
  border-radius: var(--radius-md);
}

/* 计时器 */
.cook-timer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  padding: 24rpx 0;
}
.timer-display {
  font-size: 56rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  color: #fff;
}
.timer-btn {
  padding: 16rpx 40rpx;
  border-radius: 100rpx;
  font-size: 28rpx;
  color: #fff;
  background: var(--primary);
  transition: opacity 0.15s;
}
.timer-btn:active { opacity: 0.8; }
.timer-btn.pause { background: rgba(255, 255, 255, 0.2); }

/* 底部导航 */
.cook-nav {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx 0;
}
.nav-btn {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  border-radius: var(--radius-full);
  font-size: 32rpx;
  font-weight: 600;
  transition: opacity 0.15s;
}
.nav-btn:active { opacity: 0.8; }
.nav-btn.prev {
  background: rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.85);
}
.nav-btn.prev.disabled { opacity: 0.35; }
.nav-btn.next {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #fff;
}

/* 食材浮层 */
.ing-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: var(--z-modal);
  display: flex;
  align-items: flex-end;
}
.ing-panel {
  width: 100%;
  max-height: 70vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  color: var(--text-main);
  animation: slide-up 0.25s ease both;
}
@keyframes slide-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.ing-panel-title { font-size: 32rpx; font-weight: 700; margin-bottom: 20rpx; }
.ing-panel-list { max-height: 50vh; }
.ing-panel-item {
  padding: 16rpx 0;
  font-size: 28rpx;
  color: var(--text-sub);
  border-bottom: 1rpx solid var(--divider);
}
.ing-panel-close {
  margin-top: 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 600;
}
