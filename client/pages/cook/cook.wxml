<!-- pages/cook/cook.wxml - 做菜模式 -->
<view class="cook-page">

  <!-- 加载态 -->
  <view class="cook-loading" wx:if="{{loading}}">
    <view class="skeleton" style="width:200rpx;height:200rpx;border-radius:50%;"></view>
    <view class="skeleton" style="width:500rpx;height:60rpx;margin-top:40rpx;"></view>
  </view>

  <block wx:elif="{{recipe}}">
    <!-- 顶部进度 -->
    <view class="cook-top">
      <view class="cook-exit" bindtap="exitCook">✕ 退出</view>
      <view class="cook-progress-text">步骤 {{current + 1}} / {{total}}</view>
      <view class="cook-ing-btn" bindtap="toggleIngredients">🥬 食材</view>
    </view>
    <view class="cook-progress-bar">
      <view class="cook-progress-fill" style="width: {{(current + 1) / total * 100}}%;"></view>
    </view>

    <!-- 食材浮层 -->
    <view class="ing-overlay" wx:if="{{showIngredients}}" bindtap="toggleIngredients">
      <view class="ing-panel" catchtap="">
        <view class="ing-panel-title">食材清单</view>
        <scroll-view scroll-y class="ing-panel-list">
          <view class="ing-panel-item" wx:for="{{ingredients}}" wx:key="*this">{{item}}</view>
        </scroll-view>
        <view class="ing-panel-close" bindtap="toggleIngredients">收起</view>
      </view>
    </view>

    <!-- 当前步骤（大字） -->
    <view class="cook-step-area">
      <view class="cook-step-num">STEP {{current + 1}}</view>
      <view class="cook-step-desc">{{steps[current].description}}</view>
      <image class="cook-step-img" wx:if="{{steps[current].image_url}}"
             src="{{steps[current].image_url}}" mode="aspectFill" />
    </view>

    <!-- 计时器 -->
    <view class="cook-timer" wx:if="{{timerSeconds > 0 || timerRunning}}">
      <view class="timer-display">{{timerDisplay}}</view>
      <view class="timer-btn {{timerRunning ? 'pause' : ''}}" bindtap="toggleTimer">
        {{timerRunning ? '暂停' : '开始计时'}}
      </view>
    </view>

    <!-- 底部导航 -->
    <view class="cook-nav">
      <view class="nav-btn prev {{current === 0 ? 'disabled' : ''}}" bindtap="prevStep">上一步</view>
      <view class="nav-btn next" bindtap="nextStep">
        {{current === total - 1 ? '完成 🎉' : '下一步'}}
      </view>
    </view>
  </block>

  <!-- 错误态 -->
  <view class="empty-wrap" wx:else>
    <view class="empty-icon">😢</view>
    <view class="empty-text">菜谱加载失败</view>
  </view>
</view>
