/* pages/preferences/preferences.wxss */
.page { padding: 24rpx 24rpx 0; }

.loading-wrap { padding-top: 40rpx; }
.sk-block { height: 180rpx; margin-bottom: 24rpx; border-radius: var(--radius-md); }

/* 顶部说明 */
.pref-header { padding: 16rpx 8rpx 32rpx; }
.pref-header-title { font-size: 44rpx; font-weight: 700; color: var(--text-main); }
.pref-header-desc { font-size: 26rpx; color: var(--text-sub); margin-top: 8rpx; }

/* 分区卡片 */
.pref-section { padding: 32rpx; margin-bottom: 24rpx; }
.sec-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 24rpx; }
.sec-title { font-size: 30rpx; font-weight: 600; color: var(--text-main); }
.sec-hint { font-size: 22rpx; color: var(--text-light); }

/* 多选 Chips */
.chip-wrap { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chip {
  padding: 14rpx 28rpx;
  border-radius: 100rpx;
  font-size: 26rpx;
  color: var(--text-sub);
  background: #F3F4F6;
  transition: all 0.2s ease;
}
.chip.on {
  background: var(--primary-bg);
  color: var(--primary);
  font-weight: 600;
  box-shadow: inset 0 0 0 2rpx var(--primary);
}
.chip.mini { padding: 10rpx 22rpx; font-size: 24rpx; }
.chip.warn.on {
  background: #FFF3F3;
  color: #E74C3C;
  box-shadow: inset 0 0 0 2rpx #E74C3C;
}

/* 辣度分段 */
.seg-row { display: flex; gap: 16rpx; }
.seg-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  border-radius: var(--radius-sm);
  background: #F3F4F6;
  transition: all 0.2s ease;
}
.seg-item.on { background: var(--primary-bg); box-shadow: inset 0 0 0 2rpx var(--primary); }
.seg-icon { font-size: 28rpx; margin-bottom: 6rpx; }
.seg-label { font-size: 24rpx; color: var(--text-sub); }
.seg-item.on .seg-label { color: var(--primary); font-weight: 600; }

/* 忌口标签 */
.tag-wrap { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 20rpx; }
.tag-item {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 20rpx;
  border-radius: 100rpx;
  font-size: 24rpx;
  background: #FFF3F3;
  color: #E74C3C;
}
.tag-del { font-size: 22rpx; opacity: 0.7; padding: 4rpx; }

.avoid-input-row { display: flex; gap: 16rpx; align-items: center; }
.avoid-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-sm);
  background: #F3F4F6;
  font-size: 26rpx;
}
.avoid-add-btn {
  padding: 16rpx 32rpx;
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  color: var(--text-light);
  background: #F3F4F6;
  transition: all 0.2s;
}
.avoid-add-btn.active { background: var(--primary); color: #fff; }

.suggest-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.suggest-item {
  padding: 8rpx 20rpx;
  border-radius: 100rpx;
  font-size: 24rpx;
  color: var(--primary);
  background: var(--primary-bg);
}

.quick-avoid { margin-top: 24rpx; }
.quick-label { font-size: 22rpx; color: var(--text-light); margin-bottom: 12rpx; }

/* 饮食目标列表 */
.goal-list { display: flex; flex-direction: column; gap: 16rpx; }
.goal-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-radius: var(--radius-sm);
  background: #F8F9FA;
  transition: all 0.2s ease;
}
.goal-item.on { background: var(--primary-bg); box-shadow: inset 0 0 0 2rpx var(--primary); }
.goal-label { font-size: 28rpx; font-weight: 500; color: var(--text-main); }
.goal-desc { font-size: 22rpx; color: var(--text-sub); margin-top: 4rpx; }
.goal-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  background: transparent;
  border: 2rpx solid #D1D5DB;
  transition: all 0.2s;
}
.goal-item.on .goal-check { background: var(--primary); border-color: var(--primary); }

/* 难度选择 */
.diff-row { display: flex; gap: 16rpx; }
.diff-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: var(--radius-sm);
  background: #F3F4F6;
  font-size: 26rpx;
  color: var(--text-sub);
  transition: all 0.2s ease;
}
.diff-item.on { background: var(--primary-bg); color: var(--primary); font-weight: 600; box-shadow: inset 0 0 0 2rpx var(--primary); }

/* 人数步进器 */
.stepper-row { display: flex; align-items: center; justify-content: center; gap: 48rpx; }
.stepper-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--primary);
  background: var(--primary-bg);
  transition: opacity 0.2s;
}
.stepper-btn:active { opacity: 0.7; }
.stepper-btn.disabled { opacity: 0.35; }
.stepper-value { font-size: 36rpx; font-weight: 700; color: var(--text-main); min-width: 100rpx; text-align: center; }

/* 底部操作栏 */
.pref-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
}
.footer-reset { font-size: 26rpx; color: var(--text-sub); padding: 20rpx 8rpx; }
.footer-save { flex: 1; }
.footer-save.disabled { opacity: 0.6; }
.footer-space { height: 160rpx; }
