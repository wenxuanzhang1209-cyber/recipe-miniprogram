/* pages/user/user.wxss */
.page { padding: 24rpx; }

/* 未登录卡片 */
.login-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 48rpx;
  margin-top: 80rpx;
}
.login-emoji { font-size: 120rpx; }
.login-title { font-size: 36rpx; font-weight: 700; margin-top: 24rpx; }
.login-sub { font-size: 26rpx; color: var(--text-light); margin-top: 8rpx; }
.login-btn { width: 100%; margin-top: 48rpx; }

/* 用户信息 */
.profile-card {
  display: flex;
  align-items: center;
  padding: 32rpx;
}
.avatar {
  width: 120rpx; height: 120rpx;
  border-radius: 50%;
  background: var(--primary-bg);
  flex-shrink: 0;
}
.avatar-emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}
.profile-info { flex: 1; margin-left: 24rpx; }
.nickname { font-size: 34rpx; font-weight: 700; }
.join-date { font-size: 24rpx; color: var(--text-light); margin-top: 6rpx; }
.logout-btn {
  padding: 12rpx 28rpx;
  border-radius: 100rpx;
  background: #F3F4F6;
  color: var(--text-sub);
  font-size: 24rpx;
}

/* 功能入口菜单 */
.menu-row { margin-top: 20rpx; padding: 8rpx 32rpx; }
.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
}
.menu-item:active { opacity: 0.7; }
.menu-icon { font-size: 36rpx; margin-right: 20rpx; }
.menu-label { flex: 1; font-size: 28rpx; color: var(--text-main); }
.menu-arrow { font-size: 32rpx; color: var(--text-light); }

/* 数据统计 */
.stats-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 28rpx 0;
}
.stats-item { flex: 1; text-align: center; }
.stats-num { font-size: 40rpx; font-weight: 700; color: var(--primary); }
.stats-label { font-size: 24rpx; color: var(--text-light); margin-top: 4rpx; }
.stats-divider { width: 1rpx; height: 56rpx; background: var(--divider); }

/* Tab */
.tab-bar {
  display: flex;
  align-items: center;
  gap: 40rpx;
  margin: 36rpx 8rpx 20rpx;
}
.tab-item {
  font-size: 30rpx;
  color: var(--text-sub);
  position: relative;
  padding-bottom: 8rpx;
}
.tab-item.on {
  color: var(--text-main);
  font-weight: 700;
}
.tab-item.on::after {
  content: '';
  position: absolute;
  bottom: 0; left: 50%;
  transform: translateX(-50%);
  width: 40rpx; height: 6rpx;
  background: var(--primary);
  border-radius: 100rpx;
}
.clear-history {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--text-light);
}

.list-col {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
