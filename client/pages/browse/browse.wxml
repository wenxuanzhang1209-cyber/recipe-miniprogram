<!-- pages/browse/browse.wxml - 菜谱浏览页 -->
<view class="page">

  <!-- 顶部工具栏 -->
  <view class="toolbar">
    <scroll-view class="cuisine-scroll" scroll-x enable-flick>
      <view class="cuisine-tabs">
        <view class="cuisine-tab {{activeCuisine === item ? 'on' : ''}}"
              wx:for="{{cuisines}}" wx:key="*this"
              bindtap="onCuisineTap" data-value="{{item}}">{{item}}</view>
      </view>
    </scroll-view>
    <view class="toolbar-actions">
      <view class="tool-btn" bindtap="toggleView">{{viewMode === 'grid' ? '☰' : '▦'}}</view>
      <view class="tool-btn" bindtap="toggleFilter">⚙︎</view>
    </view>
  </view>

  <!-- 排序条 -->
  <view class="sort-bar">
    <view class="sort-item {{activeSort === item.key ? 'on' : ''}}"
          wx:for="{{sorts}}" wx:key="key"
          bindtap="onSortTap" data-value="{{item.key}}">{{item.label}}</view>
  </view>

  <!-- 首屏骨架 -->
  <block wx:if="{{firstLoading}}">
    <view class="skeleton sk-item" wx:for="{{[1,2,3,4]}}" wx:key="*this"></view>
  </block>

  <!-- 列表 -->
  <block wx:else>
    <view class="{{viewMode === 'grid' ? 'grid-2' : 'list-col'}}">
      <recipe-card wx:for="{{list}}" wx:key="id" recipe="{{item}}" mode="{{viewMode}}" />
    </view>

    <view class="load-status" wx:if="{{list.length}}">
      <text wx:if="{{loading}}">加载中...</text>
      <text wx:elif="{{!hasMore}}">— 已经到底啦 —</text>
    </view>

    <view class="empty-wrap" wx:if="{{!list.length}}">
      <view class="empty-icon">🍽️</view>
      <view class="empty-text">暂无符合条件的菜谱</view>
    </view>
  </block>

  <!-- 筛选抽屉 -->
  <view class="filter-mask {{showFilter ? 'show' : ''}}" bindtap="toggleFilter">
    <view class="filter-panel" catchtap="stopBubble">
      <view class="filter-title">筛选</view>

      <view class="filter-group">
        <view class="filter-label">难度等级</view>
        <view class="filter-options">
          <view class="filter-chip {{activeDifficulty === item ? 'on' : ''}}"
                wx:for="{{difficulties}}" wx:key="*this"
                bindtap="onDifficultyTap" data-value="{{item}}">
            {{item === '不限' ? item : item + ' 星'}}
          </view>
        </view>
      </view>

      <view class="filter-group">
        <view class="filter-label">烹饪时长</view>
        <view class="filter-options">
          <view class="filter-chip {{activeMaxTime === item.value ? 'on' : ''}}"
                wx:for="{{maxTimes}}" wx:key="label"
                bindtap="onMaxTimeTap" data-value="{{item.value}}">{{item.label}}</view>
        </view>
      </view>

      <view class="filter-actions">
        <view class="filter-reset" bindtap="resetFilter">重置</view>
        <view class="filter-apply btn-primary" bindtap="applyFilter">确定</view>
      </view>
    </view>
  </view>
</view>
