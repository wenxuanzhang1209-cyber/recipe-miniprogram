/* components/recipe-card/index.wxss */
.rc {
  background: var(--card-bg, #fff);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.15s ease;
}
.rc-hover { transform: scale(0.98); }

/* ===== 网格模式 ===== */
.rc-grid { width: 100%; }
.rc-grid .rc-img-wrap { position: relative; width: 100%; height: 280rpx; }
.rc-grid .rc-img { width: 100%; height: 100%; }
.rc-grid .rc-body { padding: 20rpx; }

/* ===== 列表模式 ===== */
.rc-list { display: flex; padding: 20rpx; }
.rc-list .rc-img-wrap {
  position: relative;
  width: 220rpx;
  height: 180rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  overflow: hidden;
}
.rc-list .rc-img { width: 100%; height: 100%; }
.rc-list .rc-body {
  flex: 1;
  min-width: 0;
  padding-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

/* ===== 通用元素 ===== */
.rc-time-badge {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: 100rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 20rpx;
  backdrop-filter: blur(4px);
}

.rc-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main, #2D3436);
}

.rc-reason {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--primary, #FF6B35);
  background: var(--primary-bg, #FFF1EB);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  display: inline-block;
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.rc-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-sub, #636E72);
}

.rc-meta {
  display: flex;
  gap: 10rpx;
  margin-top: 12rpx;
}

.rc-bottom { margin-top: 14rpx; }

.rc-stars { font-size: 22rpx; }
.rc-star { color: #E5E7EB; }
.rc-star.on { color: #FDCB6E; }

.rc-views {
  font-size: 20rpx;
  color: var(--text-light, #9CA3AF);
}
