# 安全：密钥/本地配置绝不进入镜像（通过 docker-compose environment 注入）
.env
.env.*
!.env.example

# 本地数据（SQLite 开发库、备份、审计报告）
data/*.sqlite
data/*.sqlite.bak-*
data/*.json

# 依赖与构建产物（镜像内重新安装）
node_modules/
coverage/
.jest-cache/

# 测试与脚本（生产镜像不需要）
tests/
scripts/
jest.config.js
.sequelizerc

# 其他
*.log
.DS_Store
Dockerfile
.dockerignore
