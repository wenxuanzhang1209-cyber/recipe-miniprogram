# Server Configuration
PORT=3000
NODE_ENV=development

# MySQL Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=recipe_db
DB_USER=root
DB_PASSWORD=root123456

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# WeChat Mini Program Configuration
WX_APPID=your-wechat-appid
WX_SECRET=your-wechat-secret

# File Storage (optional - defaults to local)
STORAGE_TYPE=local
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
